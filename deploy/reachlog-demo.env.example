# Environment for the published read-only demo. Copy to /etc/reachlog-demo.env.
#
# DEMO_MODE seeds the database with sample contacts and replies, gives the demo
# its own data directory, records sends instead of sending them, and turns off
# mailbox sync, Telegram and email verification. REACHLOG_DEMO_PUBLIC allows the
# app to serve a non-local address; with DEMO_MODE the proxy refuses every
# request that could add, change, import or send anything, so nothing a visitor
# does can reach the shared database.
NODE_ENV=production
TZ=UTC
APP_URL=https://reachlog-demo.example.com
DEMO_MODE=true
SEED_DEMO_DATA=true
REACHLOG_DEMO_PUBLIC=true

# Leave every mail setting out. Demo mode ignores them, and a demo has no
# credentials to leak if they are not there in the first place.
