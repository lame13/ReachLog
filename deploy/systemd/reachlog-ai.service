[Unit]
Description=ReachLog AI automation worker
After=network.target

[Service]
Type=oneshot
User=reachlog
Group=reachlog
WorkingDirectory=/opt/reachlog
Environment=NODE_ENV=production
EnvironmentFile=/etc/reachlog.env
ExecStart=/usr/bin/npm run worker:ai
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/data/outreach-crm
