NODE_ENV=production
TZ=UTC
APP_URL=https://reachlog.example.com
DEMO_MODE=false
DATABASE_PATH=app.sqlite
BACKUP_DIR=backups
B2_REMOTE=

SEED_DEMO_DATA=false

APP_BASIC_AUTH_ENABLED=true
APP_BASIC_AUTH_USER=owner
APP_BASIC_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Connections can be managed in Settings without environment entries.
# Uncomment only the fields you want to manage here; they override the UI.
# SMTP_ENABLED=false
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURITY=starttls
# SMTP_TLS_VERIFY=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Optional. Pipe-separated senders. Each entry can be:
# "Name <email@example.com>" or "Name <email@example.com>::smtp_user::smtp_pass"
# SMTP_FROM_IDENTITIES=

# IMAP_ENABLED=false
# IMAP_HOST=127.0.0.1
# IMAP_PORT=1143
# IMAP_SECURITY=starttls
# IMAP_TLS_VERIFY=true
# IMAP_USER=
# IMAP_PASS=
# IMAP_MAILBOXES=INBOX,Sent
# IMAP_LOOKBACK_DAYS=90
# IMAP_AUTO_RESYNC_DAYS=90

# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

EMAILLISTVERIFY_ENABLED=false
EMAILLISTVERIFY_API_KEY=
EMAILLISTVERIFY_TIMEOUT_MS=15000
EMAILLISTVERIFY_BATCH_SIZE=25

# Set false when using cron or systemd to schedule workers instead.
# REACHLOG_SCHEDULER_ENABLED=true
