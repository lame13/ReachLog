TZ=Asia/Bangkok
APP_URL=http://localhost:3000
DATABASE_PATH=.data/app.sqlite
SEED_DEMO_DATA=false

APP_BASIC_AUTH_ENABLED=false
APP_BASIC_AUTH_USER=owner
APP_BASIC_AUTH_PASSWORD=

SMTP_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_TLS_VERIFY=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional. Pipe-separated senders. Each entry can be:
# "Name <email@example.com>" or "Name <email@example.com>::smtp_user::smtp_pass"
SMTP_FROM_IDENTITIES=

IMAP_ENABLED=false
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURITY=starttls
IMAP_TLS_VERIFY=false
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOXES=INBOX,Sent
IMAP_LOOKBACK_DAYS=90
IMAP_AUTO_RESYNC_DAYS=90

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EMAILLISTVERIFY_ENABLED=false
EMAILLISTVERIFY_API_KEY=
EMAILLISTVERIFY_TIMEOUT_MS=15000
EMAILLISTVERIFY_BATCH_SIZE=25

BACKUP_DIR=.data/backups
B2_REMOTE=
